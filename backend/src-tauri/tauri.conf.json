{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerfectPrompt",
  "version": "0.6.1",
  "identifier": "com.promptforge.app",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html#/home",
        "title": "PerfectPrompt",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "visible": true,
        "center": true,
        "decorations": true,
        "skipTaskbar": false
      },
      {
        "label": "status",
        "url": "index.html#/status",
        "title": "PerfectPrompt Status",
        "width": 220,
        "height": 70,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "index.html#/settings",
        "title": "PerfectPrompt Settings",
        "width": 540,
        "height": 720,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true
      },
      {
        "label": "clarify",
        "url": "index.html#/clarify",
        "title": "Clarify Prompt",
        "width": 600,
        "height": 550,
        "resizable": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      },
      {
        "label": "projects",
        "url": "index.html#/projects",
        "title": "PerfectPrompt — Projects",
        "width": 700,
        "height": 600,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true
      },
      {
        "label": "question-card",
        "url": "index.html#/question-card",
        "title": "Quick context",
        "width": 360,
        "height": 320,
        "minHeight": 180,
        "resizable": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "command-bar",
        "url": "index.html#/command-bar",
        "title": "PerfectPrompt",
        "width": 222,
        "height": 60,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "toast",
        "url": "index.html#/toast",
        "title": "PerfectPrompt Toast",
        "width": 360,
        "height": 96,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "annotate",
        "url": "index.html#/annotate",
        "title": "Annotate",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true
      },
      {
        "label": "mic",
        "url": "index.html#/mic",
        "title": "PerfectPrompt Mic",
        "width": 300,
        "height": 84,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["perfectprompt"]
      }
    },
    "updater": {
      "endpoints": [
        "https://perfectprompt-beta.vercel.app/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRUUzNDk1QUY1NzZFNzYKUldSMmJsZXZsVFR1WHZLMldsQ3l5bmZkWkJtUW41SEZVM0dtM0UyQUVhRy9mcWZ2KzVHdWNrV3cK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../prompts/code-enhancer.md": "prompts/code-enhancer.md",
      "../prompts/writing-enhancer.md": "prompts/writing-enhancer.md",
      "../prompts/generic-enhancer.md": "prompts/generic-enhancer.md",
      "../prompts/questions-system-prompt.md": "prompts/questions-system-prompt.md",
      "../prompts/polish-enhancer.md": "prompts/polish-enhancer.md",
      "../prompts/project-summary-generator.md": "prompts/project-summary-generator.md",
      "../prompts/annotate-enhancer.md": "prompts/annotate-enhancer.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
